<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- This is the consumer-facing optional engine: enforce that every public member is documented
         (CS1591 becomes an error under the repo's warnings-as-errors). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>DeepSigma.LogicEngine.Z3</Title>
    <Authors>DeepSigma.LogicEngine.Z3</Authors>
    <Description>A dotnet library for logical evaluation using Microsoft Z3 package.</Description>
    <PackageProjectUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.LogicEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.LogicEngine</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.0.0</Version>
    <PackageIcon>DeepSigma.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- The Z3 SMT solver (Microsoft Research). MIT-licensed; the package bundles the
         native libz3 binaries per RID. This project is the only one that takes a native
         dependency; the core DeepSigma.LogicEngine stays pure-managed. -->
    <PackageReference Include="Microsoft.Z3" Version="4.12.2" />
    <ProjectReference Include="..\DeepSigma.LogicEngine\DeepSigma.LogicEngine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="DeepSigma.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>
